# Copy to .env and fill in. Leave MT5_LOGIN=0 to use the account already logged in to the terminal.
MT5_LOGIN=0
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=
SYMBOL=XAUUSD

# Safety gates
DRY_RUN=true
ALLOW_LIVE=false

# Telegram alerts (see README): token from @BotFather, chat id from `python main.py --telegram-chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cloud dashboard on Render (optional, see README)
REMOTE_DASHBOARD_URL=
DASHBOARD_PUSH_KEY=
